# Hosts liegen in ~/.ssh/config.d/ — alphabetisch eingelesen,
# bei doppelten Optionen gewinnt der erste Treffer.
#
#   10-git.conf      GitHub / Bitbucket
#   20-private.conf  Privat (nqpi, quentins.dev)
#   30-infra.conf    Infrastruktur
#   40-crm.conf      CRM k3s Cluster
#   50-clients.conf  Kunden

Include ~/.ssh/config.d/*.conf

#Host example
  #HostName example.host
  #User exampleuser
  #Port 222
  #IdentityFile ~/.ssh/
